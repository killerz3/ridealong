{
  "name": "ridealong",
  "version": "0.4.0",
  "description": "One logged-in browser for you and your AI agents: self-hosted Chrome with a web viewer, per-agent tab isolation and workspaces that sleep when idle.",
  "type": "module",
  "bin": {
    "ridealong": "bin/ridealong.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json && tsc -p test/tsconfig.json",
    "prepare": "npm run build",
    "start": "node bin/ridealong.js start",
    "test": "npm run build && tsx test/e2e.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "keywords": [
    "browser",
    "agents",
    "cdp",
    "chrome-devtools",
    "mcp",
    "claude",
    "playwright",
    "puppeteer",
    "self-hosted",
    "remote-browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/killerz3/ridealong.git"
  },
  "license": "MIT",
  "dependencies": {
    "cn": "^0.4.0",
    "playwright-core": "^1.63.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.49.0",
    "puppeteer-core": "^25.12.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "zustand": "^5.0.15"
  }
}
